 "name": "PL_TECHINNOV_ELT",
    "properties": {
        "description": "Pipeline ELT automatisé pour le projet e-learning Techinnov. Orchestration des transformations incrémentales Snowflake, contrôle de qualité des données et alimentation de la couche Gold pour le reporting Power BI.",
        "activities": [
            {
                "name": "CHECK_SOURCE_DATA",
                "description": "Vérifier les données sources dans la couche Bronze",
                "type": "Script",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 4,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_Snowflake_Techinnov",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": "SELECT COUNT(*) AS TOTAL_SOURCE_ROWS\nFROM TECHINNOV_DB.PUBLIC.NEW_ATTEMPTS;"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00",
                    "treatDecimalAsString": false
                }
            },
            {
                "name": "MERGE_SILVER",
                "description": "Chargement incrémental Bronze vers Silver",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "CHECK_SOURCE_DATA",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 2,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_Snowflake_Techinnov",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "NonQuery",
                            "text": "MERGE INTO TECHINNOV_DB.SILVER.FACT_LEARNINGATTEMPT T\n\nUSING (\n    SELECT\n        * EXCLUDE (\n            METADATA$ACTION,\n            METADATA$ISUPDATE,\n            METADATA$ROW_ID\n        ),\n        FINALSCORE - INITIALSCORE AS SCORE_IMPROVEMENT\n\n    FROM TECHINNOV_DB.PUBLIC.STREAM_NEW_ATTEMPTS\n\n    WHERE METADATA$ACTION = 'INSERT'\n      AND INITIALSCORE BETWEEN 0 AND 100\n      AND FINALSCORE BETWEEN 0 AND 100\n      AND ATTEMPTNUMBER >= 1\n) S\n\nON T.ATTEMPTID = S.ATTEMPTID\n\nWHEN MATCHED THEN\n    UPDATE ALL BY NAME\n\nWHEN NOT MATCHED THEN\n    INSERT ALL BY NAME;"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00",
                    "treatDecimalAsString": false
                }
            },
            {
                "name": "DATA_QUALITY_CHECK",
                "description": "Contrôle de qualité des données Silver",
                "type": "Script",
                "dependsOn": [
                    {
                        "activity": "MERGE_SILVER",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "linkedServiceName": {
                    "referenceName": "LS_Snowflake_Techinnov",
                    "type": "LinkedServiceReference"
                },
                "typeProperties": {
                    "scripts": [
                        {
                            "type": "Query",
                            "text": "SELECT\n    COUNT(*) AS TOTAL_ROWS,\n\n    COUNT(*) - COUNT(DISTINCT ATTEMPTID)\n        AS DUPLICATE_IDS,\n\n    COUNT_IF(\n        ATTEMPTID IS NULL\n        OR USERKEY IS NULL\n        OR MODULEKEY IS NULL\n        OR DATEKEY IS NULL\n    ) AS NULL_KEYS,\n\n    COUNT_IF(\n        INITIALSCORE IS NULL\n        OR FINALSCORE IS NULL\n        OR INITIALSCORE NOT BETWEEN 0 AND 100\n        OR FINALSCORE NOT BETWEEN 0 AND 100\n    ) AS INVALID_SCORES,\n\n    COUNT_IF(\n        ATTEMPTNUMBER IS NULL\n        OR ATTEMPTNUMBER < 1\n    ) AS INVALID_ATTEMPTS,\n\n    COUNT_IF(\n        SCORE_IMPROVEMENT IS NULL\n        OR ABS(\n            SCORE_IMPROVEMENT -\n            (FINALSCORE - INITIALSCORE)\n        ) > 0.001\n    ) AS INVALID_IMPROVEMENT\n\nFROM TECHINNOV_DB.SILVER.FACT_LEARNINGATTEMPT;\n"
                        }
                    ],
                    "scriptBlockExecutionTimeout": "02:00:00",
                    "treatDecimalAsString": false
                }
            },
            {
                "name": "IF_DATA_QUALITY_OK",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "DATA_QUALITY_CHECK",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "expression": {
                        "value": "@and(\n    greater(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].TOTAL_ROWS, 0),\n    and(\n        equals(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].DUPLICATE_IDS, 0),\n        and(\n            equals(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].NULL_KEYS, 0),\n            and(\n                equals(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].INVALID_SCORES, 0),\n                and(\n                    equals(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].INVALID_ATTEMPTS, 0),\n                    equals(activity('DATA_QUALITY_CHECK').output.resultSets[0].rows[0].INVALID_IMPROVEMENT, 0)\n                )\n            )\n        )\n    )\n)",
                        "type": "Expression"
                    },
                    "ifFalseActivities": [
                        {
                            "name": "FAIL_PIPELINE",
                            "description": "Arrêt du pipeline en cas d'anomalie de qualité",
                            "type": "Fail",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "message": "Data quality validation failed",
                                "errorCode": "DQ_001"
                            }
                        }
                    ],
                    "ifTrueActivities": [
                        {
                            "name": "Validate_GOLD_KPI",
                            "description": "Validation des KPI e-learning",
                            "type": "Script",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:10:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "linkedServiceName": {
                                "referenceName": "LS_Snowflake_Techinnov",
                                "type": "LinkedServiceReference"
                            },
                            "typeProperties": {
                                "scripts": [
                                    {
                                        "type": "Query",
                                        "text": "SELECT *\nFROM TECHINNOV_DB.GOLD.V_KPI_MODULE;"
                                    }
                                ],
                                "scriptBlockExecutionTimeout": "02:00:00",
                                "treatDecimalAsString": false
                            }
                        }
                    ]
                }
            }
        ],
        "annotations": [],
        "lastPublishTime": "2026-11-18T18:31:50Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
